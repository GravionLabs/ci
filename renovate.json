{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 6am on Monday"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned GravionLabs/apm-hub ref of project/needs (default and fallback)",
      "managerFilePatterns": ["/^project/needs/action\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*?(?<currentDigest>[0-9a-f]{40})[^\\n]*? # (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    }
  ]
}
