{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "schedule": ["before 6am on Monday"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    },
    {
      "description": "Self-references follow the major tag (tests/self-references.test.sh): never pinned or raised by Renovate.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["GravionLabs/ci", "GravionLabs/ci/**"],
      "enabled": false
    }
  ]
}
